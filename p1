#include <iostream>
using namespace std;

int largestDigit( int n){
    if (n<10 && n>=0){
        return n;
    }
    
    int l=0;
    int d=n%10;
    if(l<d){
        l==d;
        return d;
    }
    return largestDigit(n/10);
}

int main(){
    int n;
    cin>>n; largestDigit(n);
    cout<<largestDigit(n)<<endl;
    return 0;
}
