#include <iostream>
using namespace std;

int largestDigit( int n){
    if (n<10 && n>=0){
        return n;
    }
    
    int l=largestDigit(n/10);
    int d=n%10;
    return l<d ? d : l;
  
}

int main(){
    int n;
    cin>>n; 
    largestDigit(n);
    cout<<largestDigit(n)<<endl;
    return 0;
}
