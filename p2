#include <iostream>
using namespace std;


int gcd( int a, int b){
    if ( b==0){
        return a ;
    }
   
    return gcd(b, a%b);
}

int commonFactors ( int a, int b){
   int count=0;
   for( int i=1; i<=9; i++){
       if ( gcd(a,b)%i==0){
           count++;
       }
 
   }
   return count;
   
}


int main(){
    int a,b;
    cin>>a>>b;
    commonFactors(a,b);
    cout<<commonFactors(a,b)<<endl;
    return 0;
}
